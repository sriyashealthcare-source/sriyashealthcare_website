PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sriyas_healthcare?retryWrites=true&w=majority
MONGODB_URI=

# JWT Configuration
JWT_SECRET=replace_with_a_strong_64_char_random_hex_secret
JWT_EXPIRES_IN=1d

# Allowed Frontend Origin(s) for CORS (comma-separated for multiple production/staging domains)
CLIENT_URL=http://localhost:5173
# In production, set CLIENT_URL to your Cloudflare domains:
# CLIENT_URL=https://sriyashealthcare.com,https://www.sriyashealthcare.com,https://sriyashealthcare-website.sriyashealthcare.workers.dev

# Cloudinary Configuration (for Product Images & Brochure PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Initial Administrator Account (used by seed script / initial setup)
ADMIN_NAME=Sriyas Healthcare Admin
ADMIN_EMAIL=admin@sriyashealthcare.com
ADMIN_PASSWORD=ChangeMe@Sriyas2026!

